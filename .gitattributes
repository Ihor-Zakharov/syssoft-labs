# Normalize text files to LF in the repository; the working tree gets the platform's line endings
* text=auto

# Shell scripts must stay LF even on Windows, Windows scripts stay CRLF
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.mdf binary
*.ldf binary
