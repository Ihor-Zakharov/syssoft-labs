{
  "name": "labwatch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter \"@labwatch/web^...\" build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @labwatch/shared --filter @labwatch/infra build && pnpm --parallel --filter \"./services/*\" --filter \"./apps/*\" dev",
    "db:generate": "pnpm --filter @labwatch/infra generate"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
