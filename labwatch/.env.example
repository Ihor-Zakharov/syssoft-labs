# Copy to .env and fill in. .env is git-ignored.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Recommended. Without a token labwatch stays within 40 of GitHub's 60 requests/hour per IP.
# Fine-grained personal access token: "Public repositories (read-only)", no other permissions.
GITHUB_TOKEN=

# Optional: requests per rolling hour labwatch may make (without / with a token)
# GITHUB_UNAUTH_BUDGET_PER_HOUR=40
# GITHUB_AUTH_BUDGET_PER_HOUR=2000

# Optional overrides
# GITHUB_REPOS=Ihor-Zakharov/syssoft-labs
# SOURCE_URL=https://91.202.128.107/manual.txt
# SOURCE_EXPECTED_CERT_SHA256=7F96A64D03536BC384D4CF118B4BB52DB1E906372FE73B81BF771BF90226B378
# SOURCE_EXPECTED_BODY_SHA256=02a592dd5411b84b036606dc98048ff224dec95f3ac27d8399a9d52f699c21ca

# Status page (sites checked every minute from this PC)
# STATUS_VANTAGE=home
# STATUS_DEGRADED_MS=2000
# STATUS_TIMEZONE=Europe/Kyiv
