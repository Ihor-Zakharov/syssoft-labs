# Copy to .env and fill in. .env is git-ignored.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Optional. Without a token the collector polls GitHub less often (60 requests/hour limit).
# Use a fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=

